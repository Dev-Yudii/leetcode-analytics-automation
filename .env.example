# Local configuration for the notebook.
#
# Copy this file to ".env" and fill in the values. The ".env" file is
# gitignored: it never leaves the machine.
#
# A real environment variable always wins over this file, so the GitHub
# Actions secret is never overridden by an accidental local file.

# The operational database: the pipeline and the notebook sync talk to it.
# In production this is Neon, with the application role (not the owner).
# The database name is the one of your Neon project (usually "neondb").
LEETCODE_DB_URL=postgresql://leetcode_app:password@ep-xxx-pooler.region.neon.tech/neondb?sslmode=require

# The database owner. It is used by one script only — the provisioning of
# the application role — and never by the pipeline. Leave it out if you
# do not need to provision a role again.
# LEETCODE_ADMIN_DB_URL=postgresql://neondb_owner:password@ep-xxx-pooler.region.neon.tech/neondb?sslmode=require

# The separate database used by the tests. Keep it on the local Docker
# container: the test suite creates and drops this database, and the Neon
# free plan does not allow CREATE DATABASE. When it is not set, the test
# suite derives it from LEETCODE_DB_URL.
LEETCODE_TEST_DB_URL=postgresql://leetcode:leetcode_local_dev@localhost:5432/leetcode_analytics_test

# Seconds to wait for the database before giving up.
# LEETCODE_DB_TIMEOUT=10

# Where the solution files live. Defaults to <user>/Problem-Solving/LeetCode.
# LEETCODE_OUTPUT_DIR=C:\Dev\Problem-Solving\LeetCode

# How many days the scheduled backfill looks back.
# LEETCODE_BACKFILL_DAYS=30
